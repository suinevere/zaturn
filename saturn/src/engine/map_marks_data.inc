/*----------------------
 | map_marks_data.inc
 | Description: Generated by tools/gen_map_marks.py -- do not edit. The
 |   passages Infocom's own maps mark as narrow, reconciled against each
 |   story's exit graph under the rule that the drawing may resolve a passage
 |   only where every exit on it is conditional. See that script for the
 |   derivation and map_marks.h for what the runtime does with it.
 | Author: suinevere
 ----------------------*/

/*----------------------
 | MAP_MARKS_ZORK1
 | Description: ZORK1, release 88 serial 840726.
 |   6 marks, ascending by object number then direction. A
 |   non-zero dest is the drawing supplying a destination the compiled story
 |   does not carry; where the story carries one it stays zero.
 |
 |   Passages the drawing marks that the story or the drawing's own
 |   traces did not settle, each line saying what was done about it,
 |   because a scan that silently dropped or quietly downgraded one
 |   would be indistinguishable from a scan that saw nothing:
 |     Cave (46) -- Altar (212): 1 of 2 traces found an arrowhead, so it
 |       is annotated both ways rather than retracting a direction on a
 |       split reading
 | Author: suinevere
 ----------------------*/
static const MapMark MAP_MARKS_ZORK1[] = {
    {  94,  8, 203, 1 },   /* Studio up -> Kitchen */
    { 203,  9,   0, 2 },   /* Kitchen down */
    { 206,  2,   0, 1 },   /* Timber Room west */
    { 212,  9,   0, 1 },   /* Altar down */
    { 228,  1,   0, 1 },   /* Drafty Room east */
    { 228, 11,   0, 1 },   /* Drafty Room out */
};

/*----------------------
 | MAP_MARKS_STORIES / MAP_MARKS_STORY_N
 | Description: Every story with a marks table, keyed by the release and
 |   serial in its Z-machine header. Object numbers are assigned by the
 |   compiler, so a table is only valid for the exact build it was derived
 |   from and both fields must match before it is used.
 | Author: suinevere
 ----------------------*/
static const MapMarkStory MAP_MARKS_STORIES[] = {
    { 88u, "840726", MAP_MARKS_ZORK1,
      (unsigned short) (sizeof MAP_MARKS_ZORK1 /
                        sizeof MAP_MARKS_ZORK1[0]) },
};

#define MAP_MARKS_STORY_N \
    ((int) (sizeof MAP_MARKS_STORIES / sizeof MAP_MARKS_STORIES[0]))
