# ─── Textra translation API (used by the textra-ja-to-en-mcp backend) ───
# Register at https://mt-auto-minhon-mlt.ucri.jgn-x.jp/ to obtain these.
TEXTRA_API_KEY="your_api_key"
TEXTRA_API_SECRET="your_api_secret"
TEXTRA_USER_NAME="your_login_id"

# ─── ghidra-mcp HTTP bridge ───
# Address of the running GhidraMCP HTTP server (Tools > GhidraMCP > Start MCP Server).
GHIDRA_MCP_URL="http://127.0.0.1:8089"
# Optional bearer token if you set GHIDRA_MCP_AUTH_TOKEN on the Ghidra side.
GHIDRA_MCP_AUTH_TOKEN=""

# ─── Saturn translate project ───
# Default working directory for extracted files, translation tables and rebuilt images.
SATURN_WORKDIR="./work"
