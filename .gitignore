# Fork .gitignore  —  rename to ".gitignore" at the root of zaturn.
# (SaturnRingLib and zork-netlink are SUBMODULES here, so they are NOT ignored,
#  unlike in the staging repo where they were plain untracked clones.)

# --- Saturn build output -----------------------------------------------------
saturn/BuildDrop/
**/*.o
**/*.elf
**/*.iso
**/*.cue
**/*.bin.tmp

# --- Host test binaries ------------------------------------------------------
**/*.exe
saturn/tests/**/*.out
# Bundled Windows tool binaries used by the asset pipeline (dd/xorriso/iso2raw)
!tools/assets/bin/win/*.exe

# --- multizork-server build --------------------------------------------------
server/build/
server/**/*.o
*.sqlite
*.sqlite3

# --- Cross-compiler (fetched into the SDK submodule, never committed) --------
SaturnRingLib/Compiler/

# --- IDE / OS ----------------------------------------------------------------
/.idea/
Thumbs.db
Desktop.ini
.DS_Store

# --- Non-open-source game files ---------------------------------------------
# Fetched by tools/assets/games.bat; never committed. Only Zork 1/2/3 are
# open-sourced (Activision/Microsoft) and kept in the repo.
saturn/cd/data/Z3/*.Z3
saturn/cd/data/Z3/*.z3
saturn/cd/data/Z3/*.BLB
saturn/cd/data/Z3/*.blb
!saturn/cd/data/Z3/ZORK1.Z3
!saturn/cd/data/Z3/ZORK2.Z3
!saturn/cd/data/Z3/ZORK3.Z3

# --- Asset-tool Python environment -------------------------------------------
# Provisioned on demand by tools/convert-backgrounds.sh; never committed.
tools/.venv/
**/__pycache__/
*.pyc

# --- Art pipeline working files -----------------------------------------------
# Candidates are working files until a later review promotes them; never committed.
tools/assets/candidates/

.worktrees/

# Local secrets -- never commit
tools/.env
.env

# Working art curation state. Local only; the committed record is
# art_manifest.snapshot.json, written at promote time by art_status.py --snapshot.
tools/assets/art_manifest.json
tools/assets/art_manifest.json.bak*
tools/assets/art_manifest.json.reverted-*

# Review server runtime artefacts, written by tools/servers.py.
/.asset_servers.json
/scene_server.log
/scene_server.err.log
/art_server.log
/art_server.err.log

# --- Reference discs -------------------------------------------------------
# cd/ holds original game discs used as read-only reference for the port.
# The tracks live on disk but are never committed (the Zork I JP disc alone
# is 621 MB across 32 .bin tracks).
cd/**/*.bin
cd/**/*.cue
cd/**/*.img
cd/**/*.iso
cd/**/*.mds
cd/**/*.mdf

# Derived binary dumps from the reverse-engineering workflow (VDP1/VDP2 VRAM
# captures, decompressed disc assets). All regenerable from cd/ plus a savestate.
analysis/**/*.bin
